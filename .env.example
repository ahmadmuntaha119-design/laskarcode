# ==============================================================================
# LaskarCode Supabase Environment Configuration Template
# Salin file ini menjadi .env.local dan isi dengan kredensial project Supabase Anda.
# JANGAN PERNAH commit file .env.local yang berisi secret ke Git repository!
# ==============================================================================

# Public configuration (Aman diekspos ke browser / client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only configuration (RAHASIA: Jangan pernah diekspos ke browser / client)
# Digunakan untuk server-side administrative tasks dan backend service role
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Server-only Guest Identity & Recovery Cryptographic Secrets
# Secret kunci HMAC minimal 32 karakter untuk penandatanganan cookie sesi guest
GUEST_SESSION_SECRET=your-secure-guest-session-secret-min-32-chars
# Secret kunci HMAC minimal 32 karakter untuk hashing representasi kode petualangan
RECOVERY_CODE_SECRET=your-secure-recovery-code-hmac-secret-min-32-chars
